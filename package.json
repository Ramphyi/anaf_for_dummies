{
  "name": "anaf-for-dummies",
  "version": "0.1.0",
  "private": true,
  "description": "AND (ANAF for Dummies) — facturare, e-Factura/SPV ANAF, stocuri, asistent AI și management de echipă pentru firme de outsourcing.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "rm -f data/anaf-for-dummies.db data/anaf-for-dummies.db-* && npm run db:migrate && npm run db:seed",
    "setup": "npm run db:migrate && npm run db:seed",
    "docker:up": "bash scripts/docker-up.sh",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "share": "bash scripts/make-share-zip.sh"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "openai": "^7.45.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
