# Baza de date SQLite locală (libsql). Pentru Turso: libsql://... + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/anaf-for-dummies.db
# DATABASE_AUTH_TOKEN=

# Secret pentru semnarea sesiunilor (min. 32 caractere). Generează: openssl rand -base64 48
AUTH_SECRET=schimba-ma-cu-un-secret-lung-si-aleator-de-minim-32-caractere

# URL-ul public al aplicației (folosit pentru redirect-ul OAuth ANAF)
APP_URL=http://localhost:3000

# Secret pentru endpoint-ul de cron (facturi recurente, sincronizare SPV)
CRON_SECRET=schimba-ma

# Asistent AI (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
# OPENAI_REASONING_SUMMARY=1   # afișează rezumatul raționamentului (necesită organizație verificată)
